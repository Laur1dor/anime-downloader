BOT_TOKEN=PUT_YOUR_TOKEN_HERE
ADMIN_ID=0
ACCESS_MODE=admin
MAX_CONCURRENT_JOBS=1
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=PUT_YOUR_API_HASH_HERE
TELEGRAM_API_LOCAL_MODE=1
# Задаётся compose.library.yml; пусто без общего каталога с локальным Bot API.
TELEGRAM_LOCAL_FILE_ROOT=
MAX_TG_MB=2000
LOG_LEVEL=INFO
RETRY_CACHE_MB=4096
RETRY_CACHE_HOURS=24
LIBRARY_HOST_DIR=
MEDIA_HOST_ROOT=
MEDIA_ROOT=
JELLYFIN_URL=
JELLYFIN_API_KEY=
AUDIT_POSTGRES_PASSWORD=
AUDIT_DATABASE_URL=
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_EVENTS=50000
# Жёсткий предел истории PostgreSQL; очистка раз в минуту, короткий всплеск допустим.
AUDIT_PG_MAX_EVENTS=100000
AUDIT_ALERTS=1
